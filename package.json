{
  "name": "painting-service-app",
  "version": "1.0.0",
  "description": "A full stack painting service application with React, TypeScript, and Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "webpack serve --config webpack.dev.js --mode development --hot --port 3001",
    "dev:server": "nodemon server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "webpack --mode production",
    "build:server": "tsc -p .",
    "postinstall": "prisma skills sync || exit 0",
    "setup-db": "node database-setup.js",
    "stop": "echo 'Use Ctrl+C in the terminal to stop the servers'"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "prisma": "^8.0.0-rc.19",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^8.2.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.6.8",
    "nodemon": "^3.0.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "typescript": "^5.1.6",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
