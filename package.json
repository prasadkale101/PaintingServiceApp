{
  "name": "painting-service-app",
  "version": "1.0.0",
  "description": "A full stack painting service application with React, TypeScript, and Express",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node final-dev-server.js",
    "dev:server": "nodemon server.js",
    "build": "node build-client.js",
    "build:server": "tsc -p .",
    "postinstall": "prisma skills sync || exit 0",
    "setup-db": "node database-setup.js",
    "stop": "echo 'Use Ctrl+C in the terminal to stop the servers'"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/react-router-dom": "^5.3.3",
    "concurrently": "^8.2.0",
    "nodemon": "^1.19.4",
    "prisma": "^5.12.0",
    "typescript": "^5.1.6"
  }
}
